package main

import (
	"github.com/Tend-Stack/TendUI/v2026/components"
)

// siteHeader is the one header for the landing page, documentation and demos.
// active is the request path; section adds page-specific links to the compact menu.
templ siteHeader(active string, section []components.NavItem) {
	@components.SiteHeader(components.SiteHeaderProps{
		Brand:      siteBrand(),
		BrandLabel: "TendUI home",
		BrandHref:  "/",
		Items:      siteNavigation(active),
		Section:    section,
		Actions:    components.ThemeToggle(components.ThemeToggleProps{IconOnly: true}),
		Extras:     siteSourceLink(),
	})
}

templ siteBrand() {
	<img src={ brandURL("mascot.svg") } alt="" width="40" height="40"/>
	<span class="site-wordmark">Tend <span>UI</span></span>
	<span class="site-version">Preview</span>
}

templ siteSourceLink() {
	<a href="https://github.com/Tend-Stack/TendUI" class="site-source-link">
        <svg class="site-source-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"/>
        </svg>
        Source <span aria-hidden="true">↗</span>
    </a>
}

templ siteHead() {
	@siteIcons()
	<link rel="stylesheet" href={ templ.SafeURL(headerStylesheetURL) }/>
}

// siteIcons is shared by the landing page, documentation and mounted demos.
// Hashed links avoid stale browser and proxy favicon caches after brand changes.
templ siteIcons() {
	<link rel="icon" href={ templ.SafeURL(brandURL("favicon.ico")) } sizes="16x16 32x32 48x48"/>
	<link rel="icon" href={ templ.SafeURL(brandURL("favicon-32.png")) } type="image/png" sizes="32x32"/>
	<link rel="icon" href={ templ.SafeURL(brandURL("favicon.svg")) } type="image/svg+xml" sizes="any"/>
	<link rel="apple-touch-icon" href={ templ.SafeURL(brandURL("apple-touch-icon.png")) } sizes="180x180"/>
	<link rel="manifest" href="/site.webmanifest"/>
}
