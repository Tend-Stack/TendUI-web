package site

import "github.com/Tend-Stack/GothUI/v2026/components"

// These marked recipes are compiled for previews and embedded for source downloads.
// Keep each marked block self-contained, with only the components import.

// catalog:Layout
templ ExampleLayout() {
	@components.Layout(components.LayoutProps{Title: "A GothUI page", Language: "en", Theme: components.ThemeLight}, exampleLayoutBody())
}

templ exampleLayoutBody() {
	<main><h1>A page from one Go binary.</h1><p>Semantic HTML, an embedded stylesheet, and a system font.</p><a href="/catalog/layout">Back to Layout</a></main>
}

// catalog:end

// catalog:AppShell
templ ExampleAppShell() {
	@components.AppShell(components.AppShellProps{Brand: "Studio", BrandHref: "/catalog", Title: "A place for your work", Navigation: []components.NavItem{{Label: "Catalog", Href: "/catalog", Current: true}, {Label: "Dashboard", Href: "/dashboard"}}}) {
		<p>Use one application shell inside a Layout. Its native sidebar disclosure remains keyboard operable.</p><a href="/catalog/appshell">Back to AppShell</a>
	}
}

// catalog:end

// catalog:SiteHeader
templ ExampleSiteHeader() {
	@components.SiteHeader(components.SiteHeaderProps{
		Brand:      exampleSiteHeaderBrand(),
		BrandLabel: "Studio home",
		BrandHref:  "/catalog",
		Items: []components.SiteHeaderItem{
			{Label: "Docs", Href: "/catalog"},
			{Label: "Components", Href: "/catalog/siteheader", Current: true},
			{Label: "Examples", Href: "/dashboard", AllLabel: "All examples", Groups: []components.NavGroup{
				{Title: "Layouts", Items: []components.NavItem{{Label: "Dashboard", Href: "/dashboard"}, {Label: "Workspace", Href: "/workspace"}}},
				{Title: "Forms", Items: []components.NavItem{{Label: "Form lab", Href: "/forms"}, {Label: "Form wizard", Href: "/wizard"}}},
			}},
			{Label: "Playground", Href: "/playground"},
		},
		Actions: components.ThemeToggle(components.ThemeToggleProps{IconOnly: true}),
	})
	<main id="main">
		<p>One sticky header for every page. Narrow the window to see the compact menu.</p>
		<a href="/catalog/siteheader">Back to SiteHeader</a>
	</main>
}

templ exampleSiteHeaderBrand() {
	<span>Studio</span>
}

// catalog:end

// catalog:Grid
templ ExampleGrid() {
	@components.Grid(components.GridProps{}) {
		@components.Card(components.CardProps{}) {
			<h3>One idea</h3>
			<p>Columns adapt to available space.</p>
		}
		@components.Card(components.CardProps{}) {
			<h3>Another idea</h3>
			<p>The content stays in document order.</p>
		}
	}
}

// catalog:end

// catalog:Stack
templ ExampleStack() {
	@components.Stack(components.StackProps{Gap: components.SpaceLarge}) {
		<h3>A little breathing room.</h3>
		<p>The stack owns spacing between these children. Its gap follows your page density.</p>
		@components.Stack(components.StackProps{Gap: components.SpaceSmall}) {
			<strong>A nested group</strong>
			<p>Nested stacks choose their own gap.</p>
		}
	}
}

// catalog:end

// catalog:Cluster
templ ExampleCluster() {
	@components.Cluster(components.ClusterProps{Gap: components.SpaceSmall, Justify: components.LayoutJustifyEnd}) {
		<a href="/catalog">Back to the catalog</a>
		@components.Link(components.LinkProps{Text: "Explore layouts", Href: "/patterns?section=composition", IconAfter: components.IconArrowRight})
	}
}

// catalog:end

// catalog:Prose
templ ExampleProse() {
	@components.Prose(components.ProseProps{Measure: components.MeasureStandard}) {
		<h3>Words deserve a clear home.</h3>
		<p>A readable measure keeps a guide or help article comfortable within a larger application layout.</p>
		<ul><li>Use native headings and lists.</li><li>Let your Go application own the content.</li></ul>
		<blockquote><p>Good structure works before any decoration arrives.</p></blockquote>
		<div data-prose="off">
			@components.Alert(components.AlertProps{Title: "An embedded component", Message: "This alert keeps its own typography and spacing.", Tone: components.ToneInfo})
		</div>
	}
}

// catalog:end

// catalog:Card
templ ExampleCard() {
	@components.Card(components.CardProps{Surface: components.SurfaceGradient, Elevation: components.ElevationSubtle}) {
		<h3>A thoughtful surface.</h3>
		<p>Use semantic articles with optional header, body and footer slots.</p><a href="/motion">Explore surfaces</a>
	}
}

// catalog:end

// catalog:Button
templ ExampleButton() {
	<form action="/catalog" method="get">
		<input type="hidden" name="q" value="button"/>
		@components.Button(components.ButtonProps{Text: "Find button examples", Type: components.ButtonTypeSubmit, IconBefore: components.IconSearch})
	</form>
}

// catalog:end

// catalog:Link
templ ExampleLink() {
	@components.Link(components.LinkProps{Text: "Explore the dashboard", Href: "/dashboard", Outline: true, IconAfter: components.IconArrowRight})
}

// catalog:end

// catalog:ThemeToggle
templ ExampleThemeToggle() {
	@components.ThemeToggle(components.ThemeToggleProps{Label: "Change color mode"})
}

// catalog:end

// catalog:Form
templ ExampleForm() {
	@components.Form(components.FormProps{Action: "/catalog", Method: components.MethodGet}) {
		@components.Input(components.InputProps{Name: "q", Label: "Find a component", Type: components.InputSearch, Placeholder: "Try card"})
		@components.Button(components.ButtonProps{Text: "Search catalog", Type: components.ButtonTypeSubmit})
	}
}

// catalog:end

// catalog:Input
templ ExampleInput() {
	@components.Input(components.InputProps{ID: "sample-email", Name: "email", Label: "Email address", Type: components.InputEmail, Placeholder: "alex@example.com", Autocomplete: "email"})
}

// catalog:end

// catalog:Select
templ ExampleSelect() {
	@components.Select(components.SelectProps{ID: "sample-priority", Name: "priority", Label: "Priority", Value: "normal", Options: []components.Option{{Label: "Normal", Value: "normal"}, {Label: "High", Value: "high"}}})
}

// catalog:end

// catalog:Checkbox
templ ExampleCheckbox() {
	@components.Checkbox(components.CheckboxProps{ID: "sample-summary", Name: "summary", Label: "Include a summary", Checked: true})
}

// catalog:end

// catalog:Textarea
templ ExampleTextarea() {
	@components.Textarea(components.TextareaProps{ID: "sample-note", Name: "note", Label: "Project note", Rows: 3, Placeholder: "Leave room for a small idea."})
}

// catalog:end

// catalog:RadioGroup
templ ExampleRadioGroup() {
	@components.RadioGroup(components.RadioGroupProps{ID: "sample-size", Name: "size", Legend: "Team size", Value: "small", Options: []components.Option{{Label: "Small team", Value: "small"}, {Label: "Growing team", Value: "growing"}}})
}

// catalog:end

// catalog:Switch
templ ExampleSwitch() {
	@components.Switch(components.SwitchProps{ID: "sample-digest", Name: "digest", Label: "Include a weekly digest"})
}

// catalog:end

// catalog:FileInput
templ ExampleFileInput() {
	@components.FileInput(components.FileInputProps{ID: "sample-file", Name: "attachment", Label: "Choose a local text file", Accept: ".txt", DescribedBy: "sample-file-help"})
	<small id="sample-file-help">This preview does not upload anything. Accept is a browser hint, not server validation.</small>
}

// catalog:end

// catalog:Field
templ ExampleField() {
	{{ field := components.FieldProps{ID: "sample-title", Label: "Project title", Description: "Use a short, clear name.", Required: true} }}
	@components.Field(field) {
		<input type="text" name="title" { field.ControlAttributes()... }/>
	}
}

// catalog:end

// catalog:InputGroup
templ ExampleInputGroup() {
	{{ field := components.FieldProps{ID: "sample-slug", Label: "Project URL slug", Description: "The /projects/ prefix is supplied for you."} }}
	@components.Field(field) {
		@components.InputGroup(components.InputGroupProps{Prefix: "/projects/"}) {
			<input type="text" name="slug" value="studio" { field.ControlAttributes()... }/>
		}
	}
}

// catalog:end

// catalog:Badge
templ ExampleBadge() {
	<div class="cluster">
		@components.Badge(components.BadgeProps{Text: "Ready", Tone: components.ToneSuccess})
		@components.Badge(components.BadgeProps{Text: "In progress", Tone: components.ToneInfo})
		@components.Badge(components.BadgeProps{Text: "Needs review", Tone: components.ToneWarning})
	</div>
}

// catalog:end

// catalog:Alert
templ ExampleAlert() {
	@components.Alert(components.AlertProps{Title: "Your work is ready", Message: "This is a static preview of a success message.", Tone: components.ToneSuccess})
}

// catalog:end

// catalog:ErrorSummary
templ ExampleErrorSummary() {
	@components.ErrorSummary(components.ErrorSummaryProps{Errors: []components.FieldError{{ID: "sample-invalid-name", Message: "Enter a project name."}}})
	{{ field := components.FieldProps{ID: "sample-invalid-name", Label: "Project name", Error: "Enter a project name.", Required: true} }}
	@components.Field(field) {
		<input type="text" name="name" { field.ControlAttributes()... }/>
	}
}

// catalog:end

// catalog:Skeleton
templ ExampleSkeleton() {
	@components.Skeleton(components.SkeletonProps{Label: "Placeholder preview — no active request", Lines: 3, Avatar: true})
}

// catalog:end

// catalog:EmptyState
templ ExampleEmptyState() {
	@components.EmptyState(components.EmptyStateProps{Title: "Room for your next idea", Message: "Try a different filter or browse the sample projects."}) {
		@components.Link(components.LinkProps{Text: "Browse projects", Href: "/dashboard"})
	}
}

// catalog:end

// catalog:Stat
templ ExampleStat() {
	@components.Stat(components.StatProps{Label: "Sample projects", Value: "24", Detail: "A static metric preview."})
}

// catalog:end

// catalog:DataTable
templ ExampleDataTable() {
	@components.DataTable(components.DataTableProps{Caption: "Sample project hours", Striped: true, Columns: []components.TableColumn{{Label: "Project", RowHeader: true}, {Label: "Hours", Alignment: components.AlignEnd}}, Rows: []components.TableRow{{Cells: []components.TableCell{{Text: "Studio website"}, {Text: "24"}}}, {Cells: []components.TableCell{{Text: "Team handbook"}, {Text: "12"}}}}})
}

// catalog:end

// catalog:Breadcrumbs
templ ExampleBreadcrumbs() {
	@components.Breadcrumbs(components.BreadcrumbsProps{Items: []components.BreadcrumbItem{{Label: "GothUI", Href: "/"}, {Label: "Catalog", Href: "/catalog"}, {Label: "Breadcrumbs"}}})
}

// catalog:end

// catalog:Pagination
templ ExamplePagination() {
	@components.Pagination(components.PaginationProps{Page: 1, TotalPages: 3, URLForPage: func(page int) string {
		return []string{"/catalog?page=1", "/catalog?page=2", "/catalog?page=3"}[page-1]
	}})
}

// catalog:end

// catalog:Tabs
templ ExampleTabs() {
	@components.Tabs(components.TabsProps{Label: "Catalog shortcuts", Items: []components.TabItem{{Label: "Tabs", Href: "/catalog/tabs", Current: true}, {Label: "Steps", Href: "/catalog/steps"}, {Label: "Disclosure", Href: "/catalog/disclosure"}}})
}

// catalog:end

// catalog:Steps
templ ExampleSteps() {
	@components.Steps(components.StepsProps{Label: "Example progress", Items: []components.StepItem{{Label: "Details", Completed: true}, {Label: "Review", Current: true}, {Label: "Finish"}}})
}

// catalog:end

// catalog:Disclosure
templ ExampleDisclosure() {
	@components.Disclosure(components.DisclosureProps{Summary: "A little more context"}) {
		<p>Native details and summary provide keyboard-operable disclosure behavior.</p><a href="/patterns?section=disclosures">Explore grouped disclosures</a>
	}
}

// catalog:end

// catalog:Dialog
templ ExampleDialog() {
	@components.Button(components.ButtonProps{Text: "Open the sample dialog", CommandFor: "sample-dialog", Command: components.DialogShowModal})
	<p><small>If native invoker commands are unavailable, use the <a href="/interactions?view=confirm">ordinary-page example</a>.</small></p>
	@components.Dialog(components.DialogProps{ID: "sample-dialog", Title: "A focused moment", Description: "The browser manages modal focus and dismissal."}) {
		<p>Press Escape or use Close. Nothing is saved or changed.</p>
	}
}

// catalog:end

// catalog:Popover
templ ExamplePopover() {
	@components.Button(components.ButtonProps{Text: "Show a helpful note", PopoverTarget: "sample-popover"})
	@components.Popover(components.PopoverProps{ID: "sample-popover", Title: "A small detail"}) {
		<p>Click outside or press Escape to dismiss this automatic popover.</p>
	}
}

// catalog:end

// catalog:Reveal
templ ExampleReveal() {
	@components.Reveal(components.RevealProps{Effect: components.EntryRise}) {
		@components.Card(components.CardProps{}) {
			<h3>A gentle arrival.</h3>
			<p>Reload to replay. Reduced-motion settings are respected.</p>
		}
	}
}

// catalog:end

// catalog:Icon
templ ExampleIcon() {
	<h3>Small details, clear actions.</h3>
	<p>Icons inherit text color and stay sharp at every size. Visible words remain the clearest way to describe an action.</p>
	<div class="cluster">
		@components.Link(components.LinkProps{Text: "Browse components", Href: "/catalog", IconBefore: components.IconSearch})
		@components.Link(components.LinkProps{Text: "Appearance", Href: "/settings", Outline: true, IconAfter: components.IconArrowRight})
		@components.Link(components.LinkProps{AriaLabel: "Browse all components", Href: "/catalog", Outline: true, IconBefore: components.IconMenu})
		@components.Button(components.ButtonProps{Text: "Upload unavailable", IconBefore: components.IconUpload, Disabled: true})
	</div>
	<p>
		@components.Icon(components.IconProps{Name: components.IconInfo, Size: components.IconSizeSmall})
		Small,
		@components.Icon(components.IconProps{Name: components.IconInfo})
		medium, and
		@components.Icon(components.IconProps{Name: components.IconInfo, Size: components.IconSizeLarge})
		large sizes follow the surrounding text scale.
	</p>
	<p>Standalone image with its own accessible label: @components.Icon(components.IconProps{Name: components.IconCheck, Label: "Complete"})</p>
	@components.Grid(components.GridProps{}) {
		for _, name := range components.IconNames() {
			<p>
				@components.Icon(components.IconProps{Name: name})
				<code>{ string(name) }</code>
			</p>
		}
	}
}

// catalog:end
