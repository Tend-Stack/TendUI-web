package site

import "github.com/Tend-Stack/GothUI/v2026/components"

templ demoHeader(active string) {
	<header class="demo-header">
		<a class="skip-link" href="#main">Skip to content</a>
		<a class="demo-brand" href="/" aria-label="GothUI home"><img src="/demo-gopher.svg" alt="" width="48" height="48"/><span>GothUI</span></a>
		<nav class="demo-primary" aria-label="Demo pages">
			for _, page := range []struct{ Path, Label string }{{"/", "Overview"}, {"/catalog", "Catalog"}, {"/playground", "Playground"}} {
				<a
					href={ templ.URL(page.Path) }
					if active == page.Path {
						aria-current="page"
					}
				>{ page.Label }</a>
			}
			<details class="demo-menu">
				<summary>Examples</summary>
				<div class="demo-menu-panel">
					for _, group := range []struct{ Title string; Pages []struct{ Path, Label string } }{
                        {"Forms & workflows", []struct{ Path, Label string }{{"/forms", "Form lab"}, {"/editing", "Inline editing"}, {"/wizard", "Form wizard"}, {"/uploads", "CSV preview"}}},
                        {"Application layouts", []struct{ Path, Label string }{{"/dashboard", "Dashboard"}, {"/workspace", "Workspace"}, {"/patterns", "Composition patterns"}}},
                        {"Style & behavior", []struct{ Path, Label string }{{"/settings", "Appearance studio"}, {"/interactions", "Native interactions"}, {"/motion", "Motion & surfaces"}}},
                    } {
						<div>
							<p>{ group.Title }</p>
							<ul>
								for _, page := range group.Pages {
									<li>
										<a
											href={ templ.URL(page.Path) }
											if active == page.Path {
												aria-current="page"
											}
										>{ page.Label }</a>
									</li>
								}
							</ul>
						</div>
					}
				</div>
			</details>
		</nav>
		<div class="demo-theme">@components.ThemeToggle()</div>
	</header>
}

templ demoFooter() {
	<footer><small>GothUI { version } · Native HTML and CSS. No JavaScript required.</small></footer>
}

templ demoDirectory() {
	<section aria-labelledby="demos-title">
		<h2 id="demos-title">Take it for a spin.</h2>
		@components.Grid(components.GridProps{}) {
			@components.Card(components.CardProps{Header: cardHeading("01 / Component catalog")}) {
				<p>Search the library, try a preview, and download the same templ source used to render it.</p>
				<a href="/catalog">Find a component →</a>
			}
			@components.Card(components.CardProps{Header: cardHeading("02 / Component playground")}) {
				<p>Change themes, button variants, input states, and card slots. Inspect every combination.</p>
				<a href="/playground">Open the playground →</a>
			}
			@components.Card(components.CardProps{Header: cardHeading("03 / Form lab")}) {
				<p>Exercise browser validation, server errors, reset behavior, and a successful submission.</p>
				<a href="/forms">Test a form →</a>
				<p><a href="/uploads">Preview a CSV upload →</a></p>
			}
			@components.Card(components.CardProps{Header: cardHeading("04 / Project dashboard")}) {
				<p>See cards, metrics, filters, tables, and progress indicators in a practical layout.</p>
				<a href="/dashboard">Explore the dashboard →</a>
			}
		}
	</section>
}
