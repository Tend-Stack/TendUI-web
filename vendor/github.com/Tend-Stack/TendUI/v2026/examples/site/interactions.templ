package site

import "github.com/Tend-Stack/TendUI/v2026/components"

templ interactions(confirmed bool, view string) {
	@demoHeader("/interactions")
	<main id="main">
		@components.Breadcrumbs(components.BreadcrumbsProps{Items: []components.BreadcrumbItem{{Label: "TendUI", Href: "/"}, {Label: "Examples", Href: "/playground"}, {Label: "Native interactions"}}})
		<section>
			<p class="muted">THE BROWSER CAN DO MORE</p>
			<h1>A little interaction. No extra runtime.</h1>
			<p>Try a popover, open a dialog, or walk through a confirmation. These examples use native HTML and ordinary Go form handlers.</p>
			if confirmed {
				@components.Alert(components.AlertProps{Title: "Demo approved", Message: "Your confirmation reached the server. No records were changed or saved.", Tone: components.ToneSuccess, Live: true})
			}
		</section>
		<section aria-label="Interactive examples">
			@components.Grid(components.GridProps{}) {
				@components.Card(components.CardProps{Header: cardHeading("A helpful popover")}) {
					<p>Open the panel, then click outside or press Escape to dismiss it. Tab moves through its links and close button.</p>
					@components.Button(components.ButtonProps{Text: "Show project details", PopoverTarget: "project-help"})
				}
				@components.Card(components.CardProps{Header: cardHeading("A panel that stays open")}) {
					<p>A manual popover stays visible when you click elsewhere. Use its Close button or toggle this opener again.</p>
					@components.Button(components.ButtonProps{Text: "Show pinned note", PopoverTarget: "pinned-note", Outline: true})
				}
				@components.Card(components.CardProps{Header: cardHeading("A focused dialog")}) {
					<p>The browser manages the modal backdrop and focus. Try Escape, the Close button, and reopening it.</p>
					@components.Button(components.ButtonProps{Text: "Review demo request", CommandFor: "approval-dialog", Command: components.DialogShowModal})
					<p><a href="/interactions?view=confirm#inline-confirm">Use the ordinary-page confirmation</a></p>
				}
			}
		</section>
		if view=="confirm" {
			<section id="inline-confirm" aria-labelledby="inline-title">
				@components.Card(components.CardProps{}) {
					<h2 id="inline-title">Review the demo request</h2>
					@approvalContent()
					<a href="/interactions">Cancel and return to the examples</a>
				}
			</section>
		}
		<section aria-labelledby="navigation-heading">
			<h2 id="navigation-heading">Keep your place.</h2>
			@components.Card(components.CardProps{}) {
				<p>The breadcrumb trail above shows the current page. The dashboard uses ordinary pagination links to preserve search, status, and sorting across pages.</p>
				@components.Link(components.LinkProps{Text: "Try the paginated dashboard", Href: "/dashboard", Outline: true})
			}
		</section>
		<section aria-labelledby="interaction-tests">
			<h2 id="interaction-tests">Try it with your keyboard.</h2>
			<ol><li>Tab to an opener, then press Enter or Space.</li><li>Inside the modal, Tab should remain within the dialog. Close it and check that focus returns to its opener.</li><li>Press Escape on the automatic popover or dialog. Close the manual popover explicitly.</li><li>Disable JavaScript and repeat the confirmation flow.</li></ol>
			<p><small>Dialog openers use newer native browser commands. If an opener does nothing, use the ordinary-page confirmation link. Browsers without popover support may show the panels inline.</small></p>
		</section>
	</main>
	@components.Popover(components.PopoverProps{ID: "project-help", Title: "Project details"}) {
		<p>Studio website is one of the sample projects. This panel is non-modal, so the rest of the page stays available.</p>
		<a href="/dashboard?q=studio">View the project →</a>
	}
	@components.Popover(components.PopoverProps{ID: "pinned-note", Title: "A note to keep nearby", Mode: components.PopoverManual}) {
		<p>Check keyboard focus, text contrast, and long content in both themes. This panel stays open until you close or toggle it.</p>
	}
	@components.Dialog(components.DialogProps{ID: "approval-dialog", Title: "Review demo request", Description: "Approve a sample request to exercise a normal form submission."}) {
		@approvalContent()
	}
	@demoFooter()
}

templ approvalContent() {
	<p><strong>This is a demonstration.</strong> Approval only shows a success message. Nothing is saved, sent, or deleted.</p>
	@components.Form(components.FormProps{Action: "/interactions/confirm", Method: components.MethodPost}) {
		@components.Button(components.ButtonProps{Text: "Approve demo request", Type: components.ButtonTypeSubmit, Name: "decision", Value: "approve"})
	}
}
