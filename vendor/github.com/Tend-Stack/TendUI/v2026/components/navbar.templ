package components

// NavGroup is a titled set of links inside a SiteHeader menu.
type NavGroup struct {
	Title string
	Items []NavItem
}

// SiteHeaderItem is one top-level destination. When Groups is set, the item
// renders as a native disclosure panel and Href becomes the panel's
// "view all" link. Current marks the section the visitor is in.
type SiteHeaderItem struct {
	Label    string
	Href     string
	Current  bool
	Groups   []NavGroup
	AllLabel string
	Note     string
}

type SiteHeaderProps struct {
	// Brand is the trusted logo lockup rendered inside the home link.
	Brand templ.Component
	// BrandLabel names the home link when Brand has no readable text.
	BrandLabel string
	BrandHref  string
	// Label names the primary navigation landmark. Defaults to "Primary".
	Label string
	Items []SiteHeaderItem
	// Section lists contextual links, shown in the compact menu under the current item.
	Section []NavItem
	// Actions stay visible at every width, for example ThemeToggle.
	Actions templ.Component
	// Extras show in the bar on wide screens and in the compact menu footer.
	// They render twice, so avoid fixed IDs inside them.
	Extras templ.Component
	// MenuLabel names the compact menu button and its navigation. Defaults to "Menu".
	MenuLabel string
}

// SiteHeader is a sticky site-wide bar: brand, primary links, an optional
// grouped menu, and actions. Menus are native disclosures and need no script.
// On narrow screens the links move into a full-width sheet. Use one per page.
templ SiteHeader(props SiteHeaderProps) {
	<header class="site-header">
		<div class="site-header-inner">
			<a
				class="site-brand"
				href={ templ.URL(fallback(props.BrandHref, "/")) }
				if props.BrandLabel != "" {
					aria-label={ props.BrandLabel }
				}
			>
				if props.Brand != nil {
					@props.Brand
				}
			</a>
			<nav class="site-nav" aria-label={ fallback(props.Label, "Primary") }>
				for _, item := range props.Items {
					if len(item.Groups) > 0 {
						<details class="site-menu">
							<summary
								if item.Current {
									data-current="true"
								}
							>
								{ item.Label }
								@Icon(IconProps{Name: IconChevronDown, Size: IconSizeSmall})
							</summary>
							<div class="site-menu-panel">
								<div class="site-menu-groups">
									for _, group := range item.Groups {
										<div>
											if group.Title != "" {
												<p class="site-menu-title">{ group.Title }</p>
											}
											@siteHeaderLinks(group.Items)
										</div>
									}
								</div>
								if item.Href != "" || item.Note != "" {
									<div class="site-menu-footer">
										if item.Note != "" {
											<p>{ item.Note }</p>
										}
										if item.Href != "" {
											<a href={ templ.URL(item.Href) }>{ fallback(item.AllLabel, "View all") } <span aria-hidden="true">→</span></a>
										}
									</div>
								}
							</div>
						</details>
					} else {
						<a
							href={ templ.URL(item.Href) }
							if item.Current {
								aria-current="page"
							}
						>{ item.Label }</a>
					}
				}
			</nav>
			if props.Actions != nil || props.Extras != nil {
				<div class="site-actions">
					if props.Actions != nil {
						@props.Actions
					}
					if props.Extras != nil {
						<div class="site-extras">
							@props.Extras
						</div>
					}
				</div>
			}
			<details class="site-sheet">
				<summary aria-label={ fallback(props.MenuLabel, "Menu") }>
					<span class="site-sheet-open">
						@Icon(IconProps{Name: IconMenu})
					</span>
					<span class="site-sheet-close">
						@Icon(IconProps{Name: IconClose})
					</span>
				</summary>
				<nav class="site-sheet-panel" aria-label={ fallback(props.MenuLabel, "Menu") }>
					<ul class="site-sheet-list">
						for _, item := range props.Items {
							<li>
								if len(item.Groups) > 0 {
									<details
										class="site-sheet-group"
										if item.Current {
											open
										}
									>
										<summary>
											{ item.Label }
											@Icon(IconProps{Name: IconChevronDown, Size: IconSizeSmall})
										</summary>
										for _, group := range item.Groups {
											@siteHeaderLinks(group.Items)
										}
										if item.Href != "" {
											<a class="site-sheet-all" href={ templ.URL(item.Href) }>{ fallback(item.AllLabel, "View all") } <span aria-hidden="true">→</span></a>
										}
									</details>
								} else {
									<a
										href={ templ.URL(item.Href) }
										if item.Current {
											aria-current="page"
										}
									>{ item.Label }</a>
									if item.Current && len(props.Section) > 0 {
										<div class="site-sheet-section">
											@siteHeaderLinks(props.Section)
										</div>
									}
								}
							</li>
						}
					</ul>
					if props.Extras != nil {
						<div class="site-sheet-footer">
							@props.Extras
						</div>
					}
				</nav>
			</details>
		</div>
	</header>
}

templ siteHeaderLinks(items []NavItem) {
	<ul>
		for _, link := range items {
			<li>
				<a
					href={ templ.URL(link.Href) }
					if link.Current {
						aria-current="page"
					}
				>{ link.Label }</a>
			</li>
		}
	</ul>
}
