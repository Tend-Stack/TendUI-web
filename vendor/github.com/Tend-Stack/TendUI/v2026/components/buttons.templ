package components

import "strings"

type ButtonType string

const (
	ButtonTypeButton ButtonType = "button"
	ButtonTypeSubmit ButtonType = "submit"
	ButtonTypeReset  ButtonType = "reset"
)

type ButtonProps struct {
	Text        string
	Type        ButtonType
	ID          string
	Name        string
	Value       string
	Primary     bool
	Outline     bool
	Disabled    bool
	HxGet       string
	HxPost      string
	HxTarget    string
	HxSwap      string
	HxIndicator string
	// Native targets always use type=button so they cannot accidentally submit a form.
	CommandFor    string
	Command       DialogCommand
	PopoverTarget string
	PopoverAction PopoverAction
	AutoFocus     bool
	// FormNoValidate bypasses native constraints for submit actions such as Back.
	FormNoValidate bool
	// Icons are decorative; an icon-only button must provide AriaLabel.
	IconBefore IconName
	IconAfter  IconName
	AriaLabel  string
}

func buttonType(t ButtonType) string {
	switch t {
	case ButtonTypeSubmit, ButtonTypeReset:
		return string(t)
	default:
		return "button"
	}
}

templ Button(props ButtonProps) {
	{{
		if err := validateActionIcons(props.IconBefore, props.IconAfter, props.Text, props.AriaLabel); err != nil {
			return err
		}
	}}
	<button
		type={ nativeButtonType(props) }
		class={ templ.KV("primary", props.Primary), templ.KV("outline", props.Outline) }
		disabled?={ props.Disabled }
		autofocus?={ props.AutoFocus }
		formnovalidate?={ props.FormNoValidate && nativeButtonType(props) == "submit" }
		{ nativeButtonAttrs(props)... }
		if strings.TrimSpace(props.AriaLabel) != "" {
			aria-label={ props.AriaLabel }
		}
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Name != "" {
			name={ props.Name }
		}
		if props.Value != "" {
			value={ props.Value }
		}
		{ htmxAttrs(props.HxGet, props.HxPost, props.HxTarget, props.HxSwap, props.HxIndicator)... }
	>
		if props.IconBefore != IconNone {
			@Icon(IconProps{Name: props.IconBefore})
		}
		{ props.Text }
		if props.IconAfter != IconNone {
			@Icon(IconProps{Name: props.IconAfter})
		}
	</button>
}

type LinkProps struct {
	Text        string
	Href        string
	Primary     bool
	Outline     bool
	HxGet       string
	HxPost      string
	HxTarget    string
	HxSwap      string
	HxIndicator string
	// Icons are decorative; an icon-only link must provide AriaLabel.
	IconBefore IconName
	IconAfter  IconName
	AriaLabel  string
}

templ Link(props LinkProps) {
	{{
		if err := validateActionIcons(props.IconBefore, props.IconAfter, props.Text, props.AriaLabel); err != nil {
			return err
		}
	}}
	<a
		href={ templ.URL(props.Href) }
		class={ "button", templ.KV("primary", props.Primary), templ.KV("outline", props.Outline) }
		if strings.TrimSpace(props.AriaLabel) != "" {
			aria-label={ props.AriaLabel }
		}
		{ htmxAttrs(props.HxGet, props.HxPost, props.HxTarget, props.HxSwap, props.HxIndicator)... }
	>
		if props.IconBefore != IconNone {
			@Icon(IconProps{Name: props.IconBefore})
		}
		{ props.Text }
		if props.IconAfter != IconNone {
			@Icon(IconProps{Name: props.IconAfter})
		}
	</a>
}
